# Google AI Studio
GOOGLE_API_KEY=<your-api-key>
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Vertex AI (uncomment to use)
#GOOGLE_GENAI_USE_VERTEXAI=TRUE
#GOOGLE_CLOUD_PROJECT=<your-project-id>
#GOOGLE_CLOUD_LOCATION=<your-location>
# MCP server port (default: 8282). Both the MCP server and agent read this.
MCP_PORT=8282
# Optional: override the full MCP URL (takes priority over MCP_PORT + MCP_HOST)
#MCP_SERVER_URL=http://127.0.0.1:8282/mcp
# Optional: override just the host (default: 127.0.0.1)
#MCP_HOST=127.0.0.1

# Orchestrator agent — A2A connection to currency_agent
# URL of the running currency_agent A2A server (default: http://localhost:10000)
#CURRENCY_AGENT_URL=http://localhost:10000
# Port the orchestrator_agent A2A server listens on (default: 10001)
#ORCHESTRATOR_PORT=10001
